# vu-movie — example environment file.
# Copy to `.env` (docker-compose reads it) and adjust. Everything here is optional:
# the defaults work on a DS918+ with the UI on port 8080 and hardware transcoding on.
# Environment variables always override /config/vumovie.json.

# ─── app ────────────────────────────────────────────────────────────────────
APP_PORT=8080
TZ=Europe/Amsterdam
LOG_LEVEL=info                      # debug | info | warn | error
# LAN URL VLC and the Duo2 should use. Leave empty to auto-detect from requests.
BASE_URL=
# Protect the UI/API with basic auth (stream URLs use per-stream tokens, so VLC
# and the receiver keep working without credentials).
APP_USERNAME=
APP_PASSWORD=

# ─── database ───────────────────────────────────────────────────────────────
POSTGRES_USER=vu-movie
POSTGRES_PASSWORD=vumovie
POSTGRES_DB=vumovie
REQUIRE_DB=false                    # true = refuse to start without Postgres
# Log `db slow query` when one query takes longer than this (milliseconds).
# The first reads after a start are cold — empty Postgres cache, NAS disks just
# spun up — so a one-off 700 ms `select * from streams` is normal and is now
# below the bar; lower this (or read it as a debug line) when hunting a real
# problem.
DB_SLOW_QUERY_MS=1500

# ─── transcoding (DS918+ / Celeron J3455 / HD Graphics 500) ─────────────────
TRANSCODE_MODE=auto                 # auto | copy | vaapi | x264 | h265
ALWAYS_TRANSCODE=false              # true = encode even when the source already fits
MAX_CONCURRENT_TRANSCODES=1         # 1 is the honest limit on this hardware
HWACCEL=true
VAAPI_DEVICE=/dev/dri/renderD128
# Leave empty = auto-detect. The app tries every installed driver (iHD first,
# then i965) and pins the one that really encodes a test pattern. On a DS918+
# that is usually i965, even though iHD installs fine — set LIBVA_DRIVER_NAME
# only when you want to force a specific driver.
LIBVA_DRIVER_NAME=
# How long `ffmpeg -version` may take before it counts as a failure. Generous on
# purpose: a cold/busy NAS volume can be slow, and a timeout is never treated as
# "ffmpeg is missing" (failed checks are retried in the background).
FFMPEG_PROBE_TIMEOUT_MS=30000
DEFAULT_RESOLUTION=1080
DEFAULT_VIDEO_BITRATE=8000
DEFAULT_AUDIO_BITRATE=192
DEFAULT_AUDIO_CHANNELS=6
DEFAULT_FPS=25
DEFAULT_CONTAINER=mpegts            # mpegts | matroska | hls
MEM_LIMIT=2500m
# How many times the relay may restart ffmpeg while someone is watching.
STREAM_MAX_RESTARTS=3
# Live clients (VLC, the browser, the VU+) are real-time players: they drain
# ~1-3 MB/s. ffmpeg therefore reads the input at the source's native rate
# (-re) instead of bursting the whole movie into the client socket at many
# times real time — an unpaced relay fills the client's buffer within seconds
# and the backlog guard drops it ("cannot keep up") a few seconds into the
# film. Set to false only if you deliberately want full-speed streaming.
REALTIME_PLAYBACK=true
# ── chunked upstream proxy (MovieBox-TUI fetching mechanism) ────────────────
# Many CDNs end a chunked transfer after a few minutes of footage, which cut
# playback short. With the proxy ON, vu-movie itself pulls the movie in small
# ranged requests (signed headers replayed on every request, every request
# retried) and feeds ffmpeg locally — the complete movie plays.
UPSTREAM_PROXY=true
UPSTREAM_CHUNK_BYTES=1048576        # range size for progressive mp4/mkv mirrors
UPSTREAM_SEGMENT_CHUNK_BYTES=97280  # 95 KB sub-ranges inside a DASH segment
UPSTREAM_PARALLEL=4                 # parallel sub-ranges while assembling a segment
UPSTREAM_CACHE_MB=64                # per-session cache budget for chunks/segments
UPSTREAM_REQUEST_TIMEOUT_MS=30000

# ─── VU+ Duo2 (Enigma2) ─────────────────────────────────────────────────────
ENIGMA2_HOST=192.168.1.50
ENIGMA2_PORT=80
ENIGMA2_USER=root
ENIGMA2_PASSWORD=
ENIGMA2_BOUQUET=vu-movie
ENIGMA2_SERVICE_TYPE=4097           # 4097 GStreamer | 5001 gstplayer | 5002 exteplayer3 | 1 DVB
                                    # Text subtitles: favour 5002 + the .mkv (default-flagged
                                    # soft track) or burn the subtitle in; 5002 exposes no
                                    # subtitle menu, so an un-flagged track looks "missing".
                                    # DVB bitmap subtitles in MPEG-TS need service type 1.
ENIGMA2_FTP=true                    # FTP writes bouquet/subtitle files; OpenWebif is reload/query only
ENIGMA2_FTP_PORT=21
ENIGMA2_ROOT=/etc/enigma2           # folder on the box for the bouquet and the subtitle copies
ENIGMA2_AUTO_PUSH=false             # push the bouquet after every playlist change

# ─── subtitles ──────────────────────────────────────────────────────────────
SUBTITLE_LANGUAGES=nl,en            # order = preference
SUBTITLE_PUSH=false                 # auto-push every downloaded .srt to the receiver
SUBTITLE_RECEIVER_DIR=/media/hdd/movie/vumovie   # where those copies land (per item: Playlist → ▤ subtitle → copy)
OPENSUBTITLES_API_KEY=              # opensubtitles.com (free tier, 5-20 dl/day)
SUBDL_API_KEY=                      # subdl.com (free key, 2000 requests/day)

# ─── scraping ───────────────────────────────────────────────────────────────
BROWSER_CONCURRENCY=1               # headless Chromium pages at once (1 on a DS918+)
RESOLVE_TIMEOUT_MS=45000
# How long a source's search page may take to render its result cards. The
# flixer clones (redflix, cinejoy, 1flex) ship an empty shell and fetch their
# results over XHR, so this has to outlast that fetch; the search stops early as
# soon as the cards stop growing, so raising it costs nothing for fast sites.
SEARCH_WAIT_MS=12000
# FlareSolverr solves Cloudflare / "Just a moment…" challenges for sources like
# cinevo.nl that sit behind bot protection. It's started automatically by
# docker-compose (see the flaresolverr service). Set FLARESOLVERR_URL to point
# at it. Leave FLARESOLVERR_URL empty only if you don't want to run the
# FlareSolverr container — sources behind Cloudflare will then be skipped with
# a clear "FlareSolverr not configured" log message, rather than returning
# the interstitial page as 0 results.
FLARESOLVERR_HOST_PORT=8193         # host/NAS port; FlareSolverr listens on 8192 inside the container
# NOTE: put the comment on its own line. Some .env parsers (older compose
# builds, `docker run --env-file`, DSM Container Manager) keep an inline
# "# …" as part of the value, which is why the app now strips it — but
# avoiding it costs nothing.
FLARESOLVERR_URL=http://flaresolverr:8192
# Per-page budget for the solver (its own default is 60s). Raise it if the log
# says "FlareSolverr timed out solving the challenge" on a slow NAS.
FLARESOLVERR_TIMEOUT_MS=30000
# Chromium inside the FlareSolverr container hangs or dies on Docker's 64 MB
# /dev/shm default (the symptom is "Error getting browser User-Agent … Read
# timed out" and a restart loop), so give it headroom. /dev/shm counts towards
# the memory limit, hence the 1200 MB default there.
FLARESOLVERR_SHM_SIZE=512m
FLARESOLVERR_MEM_LIMIT=1200m
# Pin the image when a `latest` release misbehaves, e.g.
# FLARESOLVERR_IMAGE=flaresolverr/flaresolverr:v3.3.21
FLARESOLVERR_IMAGE=flaresolverr/flaresolverr:latest
# A per-source circuit breaker backs failing sources off after 2/2/4
# consecutive hard failures (60s → 5m → 30m cooldowns) so repeated
# searches don't pay Chromium / TLS timeouts for dead hosts.
EXTERNAL_EXTRACTOR_URL=             # optional external resolver (see docs/MOCKUP.md §3)
# When a resolve ends with 0 candidates the app probes a control host and
# compares the container's DNS answers with public resolvers, so the error says
# *which* layer is broken: no egress at all, filtered DNS, a TLS-intercepting
# proxy, or a dead API. Costs ~4 s, cached for a minute. Set false to skip.
DIAGNOSE_ON_FAILURE=true
DNS_CHECK_SERVERS=1.1.1.1,8.8.8.8,9.9.9.9   # used for the comparison only, not for scraping
# ── MovieBox SNI/IP block bypass ──────────────────────────────────────────
# If api*.aoneroom.com closes the TLS handshake (diagnosis: tls-or-ip-block)
# your ISP is SNI-filtering it. Two automatic workarounds exist:
#   MOVIEBOX_PROXY=http://proxy:3128   # or socks5://proxy:1080 — any forward proxy/VPN that CAN reach the host
#   MOVIEBOX_BROWSER_FALLBACK=true     # (default) retry the same API call via Chromium (BoringSSL, different JA3)
# Both respect NO_PROXY (localhost by default). You can also extend the host
# pool when mirrors rotate: MOVIEBOX_EXTRA_HOSTS=https://custom.example
MOVIEBOX_PROXY=
MOVIEBOX_EXTRA_HOSTS=
MOVIEBOX_BROWSER_FALLBACK=true
# Which MovieBox backend to talk to:
#   auto   (default) mobile BFF first (api*.aoneroom.com/wefeed-mobile-bff, the
#           API MovieBox-TUI speaks), and when every one of those hosts dies in
#           the TLS handshake, retry the same search on the *web* BFF
#           (h5-api.aoneroom.com/wefeed-h5api-bff + the public site mirrors) —
#           different hosts, so it survives filters that target the api* edge.
#   h5     always use the web BFF first.
#   mobile never use the web BFF.
MOVIEBOX_TRANSPORT=auto
# Standard proxy env passthrough (also honoured, MOVIEBOX_PROXY has priority):
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1

# ─── advanced: paths, tuning, self-hosted runs ──────────────────────────────
# Everything here already has a working default. The Settings page does not show
# these (it edits /config/vumovie.json); set them in `.env` when the default does
# not fit your box. Values in parentheses are the built-in defaults.
#
# Paths — in the container all of these live on the /config volume; the Dockerfile
# and docker-compose already point DOWNLOADS_DIR/TMP_DIR at the mounted volumes.
# CONFIG_FILE=/config/vumovie.json  # the other path defaults derive from its folder
# DOWNLOADS_DIR=                    # (<config dir>/downloads) finished download jobs
# TMP_DIR=                          # (<config dir>/tmp) live-test and cache scratch space
# SOURCES_DIR=                      # (<config dir>/sources) drop-in scraper recipes
# SESSION_DIR=                      # (<config dir>/sessions) per-source Cloudflare cookies
# HWACCEL_CACHE=                    # (<config dir>/hwaccel.json) cached VA-API self-test result
#
# HTTP / playlist
# HOST=0.0.0.0                      # bind address inside the container
# PORT=8080                         # listen port; compose maps APP_PORT (host) onto this
# PLAYLIST_NAME=vu-movie            # name in the .m3u, the bouquet and the download filenames
# PLAYLIST_AUTO_CHECK=true          # periodically check every Playlist item
# PLAYLIST_CHECK_INTERVAL_MINUTES=360 # run every 6 hours (15–10080 minutes)
# PLAYLIST_AUTO_REPAIR=true         # refresh dead upstream URLs via the same/other providers
# XTREAM_USERNAME=vumovie           # Xtream account — also settable in Settings → Xtream Codes
# XTREAM_PASSWORD=                  # empty = the playlist token doubles as the password
                                    # set here, these two win over a value saved from the Settings tab
# TOKEN_TTL_MINUTES=0               # lifetime of a stream's token in minutes; 0 = never expires (default). Overrides the Settings value
# PROBE_DURATION=true               # learn each movie's length once with ffprobe, so playback stops at the real end (false = skip)
# LOG_BUFFER=1000                   # log lines kept in memory for the Logs tab
# CACHE_BUDGET_MB=2048              # on-disk HLS cache ceiling (per session, MB)
# MAX_CONCURRENT_DOWNLOADS=1        # download jobs at once (transcodes use MAX_CONCURRENT_TRANSCODES)
#
# Transcode / scraper tuning
# STREAM_IDLE_SECONDS=45            # stop a relay session this long after the last player left
# BROWSER_IDLE_SECONDS=180          # close the headless Chromium after this idle time
# MAX_CANDIDATES=12                 # stop resolving after this many working candidates
# PROBE_CANDIDATES=true             # ffprobe each candidate (false = take the first title match)
# DEFAULT_ASPECT=source             # source | 169 | 43 — used when the source looks unusual
# ENCODER_FALLBACK=libx264 -preset veryfast -crf 22   # software fallback when VA-API fails
# MAX_CLIENT_BACKLOG=12582912       # 12 MB — a live client further behind than this is dropped
# FFMPEG_PATH=ffmpeg                # ffmpeg binary (path)
# FFPROBE_PATH=ffprobe              # ffprobe binary (path)
# FFMPEG_LOGLEVEL=warning           # ffmpeg -loglevel: what lands in the Test tab and the log
# CHROMIUM_PATH=                    # Chromium for the scraper (PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH works too)
# LIBVA_DRIVERS_PATH=/usr/lib/x86_64-linux-gnu/dri
# VAAPI_SELFTEST_TIMEOUT_MS=30000   # how long the VA-API self-test may take (min 5000)
# VAINFO_TIMEOUT_MS=15000           # how long vainfo may take (min 2000)
# HWACCEL_RETRY_MS=300000           # re-test the GPU after a failed self-test this often (min 60000)
#
# Database
# DB_POOL_MAX=5                     # Postgres connections in the pool
# WAIT_FOR_DB_MS=60000              # how long to wait for Postgres before falling back to memory
#
# Subtitles (the keys ABOVE cover opensubtitles.com and subdl)
# SUBTITLE_AUTO_SEARCH=true         # search subtitles right after a stream resolves
# OPENSUBTITLES_ORG_USER=           # opensubtitles.org (legacy free service) + password
# OPENSUBTITLES_ORG_PASS=
# ADDIC7ED_USER=                    # addic7ed free account — enables the Addic7ed
# ADDIC7ED_PASS=                    # provider (anonymous downloads are throttled to nothing)
#
# Scraper identity
# USER_AGENT=                       # browser UA; default is a desktop Chrome string
#
# Internal (leave alone unless you know why): PUBLIC_DIR, MIGRATIONS_DIR,
# APP_VERSION, FFMPEG_PROBE_RETRIES.
