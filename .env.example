# vu-movie — example environment file.
# Copy to `.env` (docker-compose reads it) and adjust. Everything here is optional:
# the defaults work on a DS918+ with the UI on port 8080 and hardware transcoding on.
# Environment variables always override /config/vumovie.json.

# ─── app ────────────────────────────────────────────────────────────────────
APP_PORT=8080
TZ=Europe/Amsterdam
LOG_LEVEL=info                      # debug | info | warn | error
# LAN URL VLC and the Duo2 should use. Leave empty to auto-detect from requests.
BASE_URL=
# Protect the UI/API with basic auth (stream URLs use per-stream tokens, so VLC
# and the receiver keep working without credentials).
APP_USERNAME=
APP_PASSWORD=

# ─── database ───────────────────────────────────────────────────────────────
POSTGRES_USER=vu-movie
POSTGRES_PASSWORD=vumovie
POSTGRES_DB=vumovie
REQUIRE_DB=false                    # true = refuse to start without Postgres

# ─── transcoding (DS918+ / Celeron J3455 / HD Graphics 500) ─────────────────
TRANSCODE_MODE=auto                 # auto | copy | vaapi | x264 | h265
ALWAYS_TRANSCODE=false              # true = encode even when the source already fits
MAX_CONCURRENT_TRANSCODES=1         # 1 is the honest limit on this hardware
HWACCEL=true
VAAPI_DEVICE=/dev/dri/renderD128
# Leave empty = auto-detect. The app tries every installed driver (iHD first,
# then i965) and pins the one that really encodes a test pattern. On a DS918+
# that is usually i965, even though iHD installs fine — set LIBVA_DRIVER_NAME
# only when you want to force a specific driver.
LIBVA_DRIVER_NAME=
# How long `ffmpeg -version` may take before it counts as a failure. Generous on
# purpose: a cold/busy NAS volume can be slow, and a timeout is never treated as
# "ffmpeg is missing" (failed checks are retried in the background).
FFMPEG_PROBE_TIMEOUT_MS=30000
DEFAULT_RESOLUTION=1080
DEFAULT_VIDEO_BITRATE=2500
DEFAULT_AUDIO_BITRATE=128
DEFAULT_CONTAINER=mpegts            # mpegts | matroska | hls
MEM_LIMIT=2500m

# ─── VU+ Duo2 (Enigma2) ─────────────────────────────────────────────────────
ENIGMA2_HOST=192.168.1.50
ENIGMA2_PORT=80
ENIGMA2_USER=root
ENIGMA2_PASSWORD=
ENIGMA2_BOUQUET=vu-movie
ENIGMA2_SERVICE_TYPE=4097           # 4097 GStreamer | 5001 | 5002 | 1 DVB
ENIGMA2_FTP=false                   # enable for uploads/subtitle push via FTP

# ─── subtitles ──────────────────────────────────────────────────────────────
SUBTITLE_LANGUAGES=nl,en            # order = preference
SUBTITLE_PUSH=false                 # push .srt files to the receiver
OPENSUBTITLES_API_KEY=              # opensubtitles.com (free tier, 5-20 dl/day)
SUBDL_API_KEY=                      # subdl.com (free key, 2000 requests/day)

# ─── scraping ───────────────────────────────────────────────────────────────
BROWSER_CONCURRENCY=1               # headless Chromium pages at once (1 on a DS918+)
RESOLVE_TIMEOUT_MS=45000
# FlareSolverr solves Cloudflare / "Just a moment…" challenges for sources like
# cinevo.nl that sit behind bot protection. It's started automatically by
# docker-compose (see the flaresolverr service). Set FLARESOLVERR_URL to point
# at it. Leave FLARESOLVERR_URL empty only if you don't want to run the
# FlareSolverr container — sources behind Cloudflare will then be skipped with
# a clear "FlareSolverr not configured" log message, rather than returning
# the interstitial page as 0 results.
FLARESOLVERR_HOST_PORT=8193         # host/NAS port; FlareSolverr listens on 8192 inside the container
FLARESOLVERR_URL=http://flaresolverr:8192   # container-to-container address, not the host port
# A per-source circuit breaker backs failing sources off after 2/2/4
# consecutive hard failures (60s → 5m → 30m cooldowns) so repeated
# searches don't pay Chromium / TLS timeouts for dead hosts.
EXTERNAL_EXTRACTOR_URL=             # optional external resolver (see docs/MOCKUP.md §3)
