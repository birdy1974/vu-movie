{
  "_comment": "Example of /config/vumovie.json. Copy to config/vumovie.json (or set CONFIG_FILE) and edit. Environment variables always win over this file. Every option is a NESTED object — write \"scraper\": { \"flaresolverrUrl\": \"…\" }, never a flat \"scraper.flaresolverrUrl\" key: JSON has no dotted paths, so the flat spelling is ignored (the app now says so in the log instead of staying quiet). Saving from the Settings page rewrites this file in the correct shape.",
  "app": {
    "host": "0.0.0.0",
    "port": 8080,
    "baseUrl": "",
    "logLevel": "info",
    "username": "",
    "password": "",
    "tokenTtlMinutes": 4320
  },
  "db": {
    "url": "postgres://vu-movie:vumovie@db:5432/vumovie",
    "required": false,
    "waitForDbMs": 60000
  },
  "transcode": {
    "_comment": "videoBitrate/audioBitrate/audioChannels/fps below are the practical DS918+ values from docs/SYNO.md; the built-in defaults are 8000/192/6/25 and the Settings page writes whatever you pick there.",
    "mode": "auto",
    "alwaysTranscode": false,
    "maxConcurrent": 1,
    "hardware": true,
    "device": "/dev/dri/renderD128",
    "resolution": 1080,
    "aspect": "source",
    "videoBitrate": 2500,
    "audioBitrate": 128,
    "audioChannels": 2,
    "fps": "source",
    "container": "mpegts",
    "idleStopSeconds": 45,
    "pauseKeepSeconds": 900,
    "resumeHours": 12,
    "clientStallSeconds": 1800,
    "maxRestarts": 3,
    "realtime": true,
    "upstreamProxy": true,
    "upstreamChunkBytes": 1048576,
    "upstreamSegmentChunkBytes": 97280,
    "upstreamParallel": 4,
    "upstreamCacheMb": 64,
    "upstreamRequestTimeoutMs": 30000,
    "encoderFallback": "libx264 -preset veryfast -crf 22",
    "ffmpegTemplates": [],
    "defaultFfmpegTemplateId": ""
  },
  "subtitles": {
    "languages": [
      "nl",
      "en"
    ],
    "autoSearch": true,
    "pushToReceiver": false,
    "receiverDir": "/media/hdd/movie/vumovie",
    "keys": {
      "opensubtitlesCom": "",
      "subdl": ""
    },
    "credentials": {
      "opensubtitlesOrgUser": "",
      "opensubtitlesOrgPass": "",
      "addic7edUser": "",
      "addic7edPass": ""
    },
    "customProviders": [
      {
        "_comment": "Example of a user-defined subtitle source. Works for any site returning links or JSON.",
        "id": "example",
        "name": "Example source",
        "enabled": false,
        "searchUrl": "https://example.org/search?q={query}&lang={lang}",
        "downloadUrl": "",
        "parse": {
          "kind": "html",
          "regex": "<a[^>]+href=\"(?<url>[^\"]+)\"[^>]*>(?<title>[^<]{2,120})<"
        }
      }
    ],
    "disabledProviders": []
  },
  "enigma2": {
    "host": "192.168.1.50",
    "port": 80,
    "username": "root",
    "password": "",
    "bouquetName": "vu-movie",
    "rootDir": "/etc/enigma2",
    "serviceType": 4097,
    "ftpEnabled": true,
    "ftpPort": 21,
    "autoPush": false
  },
  "scraper": {
    "browserConcurrency": 1,
    "browserIdleSeconds": 180,
    "resolveTimeoutMs": 45000,
    "probeCandidates": true,
    "maxCandidates": 12,
    "flaresolverrUrl": "",
    "externalExtractorUrl": "",
    "diagnoseOnFailure": true,
    "dnsCheckServers": [
      "1.1.1.1",
      "8.8.8.8",
      "9.9.9.9"
    ],
    "customSources": [],
    "proxyUrl": "",
    "noProxy": "localhost,127.0.0.1,::1",
    "movieboxExtraHosts": [],
    "movieboxBrowserFallback": true,
    "movieboxTransport": "auto",
    "flaresolverrTimeoutMs": 30000,
    "sessionDir": "/config/sessions",
    "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/121.0.0.0 Safari/537.36"
  },
  "storage": {
    "downloads": "/config/downloads",
    "tmp": "/tmp/vumovie",
    "cacheBudgetMb": 2048
  },
  "playlist": {
    "_comment": "The app maintains token and items itself; name and the Xtream account are editable here or in the Settings tab (PLAYLIST_NAME / XTREAM_USERNAME / XTREAM_PASSWORD win). An empty xtreamPassword means the token doubles as the password.",
    "name": "vu-movie",
    "token": "",
    "xtreamUsername": "vumovie",
    "xtreamPassword": "",
    "items": []
  },
  "sources": {
    "dir": "/config/sources",
    "enabled": [],
    "disabled": []
  }
}
