[
  {
    "id": "overlook",
    "name": "Overlook",
    "home": "https://overlook.cx/lobby",
    "enabled": true,
    "match": [
      "overlook.cx"
    ],
    "kind": "browser",
    "search": {
      "kind": "api",
      "url": "https://overlook.cx/api/search?q={query}",
      "items": "results",
      "resultUrl": "/{type}/{id}",
      "typeMap": {
        "movie": "movies",
        "tv": "shows"
      },
      "posterBaseUrl": "https://image.tmdb.org/t/p/w500/",
      "map": {
        "id": "id",
        "title": "t",
        "year": "y",
        "kind": "mediaType",
        "poster": "posterPath",
        "rating": "vote_average",
        "genres": "genres",
        "description": "overview",
        "runtime": "runtime",
        "releaseDate": "release_date",
        "language": "original_language"
      },
      "openMode": "home"
    },
    "resolve": {
      "kind": "browser"
    },
    "notes": "Search uses Overlook’s JSON catalog API; title resolution still uses the browser sniffer."
  },
  {
    "id": "cinevo",
    "name": "Cinevo",
    "home": "https://cinevo.nl",
    "enabled": true,
    "match": [
      "cinevo.nl"
    ],
    "kind": "browser",
    "search": {
      "kind": "browser",
      "url": "https://cinevo.nl/search?q={query}",
      "linkPattern": "/(movie|tv|serie|watch)/"
    },
    "resolve": {
      "kind": "browser"
    },
    "notes": "Dutch-oriented front-end; TMDB based. Best treated with the browser sniffer."
  },
  {
    "id": "cinejoy",
    "name": "Cinejoy",
    "home": "https://cinejoy.pk/",
    "enabled": true,
    "match": [
      "cinejoy.pk"
    ],
    "kind": "browser",
    "search": {
      "kind": "browser",
      "url": "https://cinejoy.pk/search/{query}",
      "linkPattern": "/(movie|tv|series|watch)/",
      "waitMs": 15000
    },
    "resolve": {
      "kind": "browser",
      "playerPathPrefix": "/watch"
    },
    "notes": "Encrypted player API (POST /g on api.wing.st, decrypted by a WASM blob in the browser). Behind DDoS-Guard and fully client-rendered: results appear ~5-10s after load, hence search.waitMs. If the detail page hides its CTA, resolution falls back from /movie/... to /watch/movie/...; the browser sniffer then reads the URL after the site decrypts it."
  },
  {
    "id": "flixhub",
    "name": "Flixhub",
    "home": "https://flixhub.studio/home",
    "enabled": true,
    "match": [
      "flixhub.studio"
    ],
    "kind": "browser",
    "search": {
      "kind": "browser",
      "url": "https://flixhub.studio/search?q={query}",
      "linkPattern": "watch\\.html\\?type=|/(movie|film|tv|series?|title|watch)/"
    },
    "resolve": {
      "kind": "browser"
    },
    "notes": "Flixer clone; same farms as Overlook/1flex."
  },
  {
    "id": "redflix",
    "name": "Redflix",
    "home": "https://redflix.club/",
    "enabled": true,
    "match": [
      "redflix.club"
    ],
    "kind": "browser",
    "search": {
      "kind": "browser",
      "url": "https://redflix.club/browse?q={query}",
      "linkPattern": "/play\\?id=|/(movie|film|tv|series?|watch|title)/",
      "waitMs": 15000
    },
    "resolve": {
      "kind": "browser"
    },
    "notes": "Aggregator front-end (Next.js): the shell is server-rendered but the result cards appear only after the client fetches them, so search needs a long wait (search.waitMs) instead of the default settle."
  },
  {
    "id": "flex1",
    "name": "1flex",
    "home": "https://www.1flex.org/",
    "enabled": true,
    "match": [
      "1flex.org"
    ],
    "kind": "browser",
    "search": {
      "kind": "browser",
      "url": "https://www.1flex.org/search?q={query}",
      "linkPattern": "/(movie|tv|watch)/",
      "waitMs": 15000
    },
    "resolve": {
      "kind": "browser"
    },
    "notes": "Flixer clone (same player farm as Overlook/Flixhub). Its search page fires an ad pop-under that navigates the tab to youtube.com a few hundred ms after domcontentloaded — the browser layer blocks the redirect and retries once in a fresh tab, which is why the wait has to outlast the first (hijacked) load."
  },
  {
    "id": "cinezo",
    "name": "Cinezo",
    "home": "https://cinezo.st/",
    "enabled": true,
    "match": [
      "cinezo.st"
    ],
    "kind": "browser",
    "search": {
      "kind": "browser",
      "url": "https://cinezo.st/search?q={query}",
      "linkPattern": "/(movie|tv|watch)/"
    },
    "resolve": {
      "kind": "browser"
    },
    "notes": "Open player API — a native adapter can be added as a fast path (kind:api) once the endpoint shape is confirmed from your network."
  },
  {
    "id": "flixer-gd",
    "name": "Flixer.gd",
    "home": "https://flixer.gd/",
    "enabled": true,
    "match": [
      "flixer.gd"
    ],
    "kind": "browser",
    "search": {
      "kind": "browser",
      "url": "https://flixer.gd/search?q={query}",
      "linkPattern": "/(movie|film|tv|series?|watch)/",
      "waitMs": 10000
    },
    "resolve": {
      "kind": "browser"
    },
    "notes": "Kept separate from Flixer.su because an exact shared redirect destination has not been confirmed."
  },
  {
    "id": "flixer-su",
    "name": "Flixer.su",
    "home": "https://flixer.su/",
    "enabled": true,
    "match": [
